# Site
NEXT_PUBLIC_SITE_URL=https://diplox.online

# Бюджет стадии AI-разметки блоков, мс (по умолчанию 25000).
# Стадия живёт внутри функции с maxDuration = 60 с; по исчерпании бюджета
# оставшиеся параграфы размечаются правилами, а не роняют задачу по таймауту.
# Роут дополнительно ограничивает стадию дедлайном всего запроса (50 с).
MARKUP_BUDGET_MS=25000

# Очистка (GET /api/cleanup). Два триггера, оба необязательные:
#   CLEANUP_SECRET — для crontab на Timeweb: /api/cleanup?secret=...
#   CRON_SECRET    — Vercel Cron сам шлёт его как Authorization: Bearer ...
# Если не задан ни один, роут открыт.
CLEANUP_SECRET=
CRON_SECRET=

# AI Model Rotation Configuration
# Gateway автоматически выбирает лучшую доступную модель
# Достаточно настроить ключи — модели с пустыми ключами пропускаются

# Google Gemini (3 модели × 20 RPD = 60 запросов/день)
# Получить ключ: https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=

# Groq (Llama 3.3 70B — 14400 RPD, очень быстрый)
# Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (бесплатные модели — Llama, Gemma)
# Получить ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras (Llama 3.3 70B — 1000 RPD)
# Получить ключ: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# OpenAI (платный, опционально)
OPENAI_API_KEY=

# Anthropic (платный, опционально)
ANTHROPIC_API_KEY=

# Supabase
# Создать проект: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Yandex OAuth (Yandex ID)
# Создать приложение: https://oauth.yandex.ru/ → Callback URI: https://diplox.online/api/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Analytics
# Yandex.Metrika: https://metrika.yandex.ru/ → создать счётчик → скопировать ID
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Google Analytics 4: https://analytics.google.com/ → создать ресурс → скопировать Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search Console Verification
# Google: https://search.google.com/search-console → добавить ресурс → метод "Тег HTML" → скопировать content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Yandex: https://webmaster.yandex.ru/ → добавить сайт → метод "Мета-тег" → скопировать content
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Доля задач, которые обрабатывает экспериментальный pipeline-v7 (целое 0–100,
# бакет считается от jobId; пусто или мусор = 0 = выключено).
# Любой сбой v7 (гейт верности, отказ классификатора, таймаут 40 с, исключение)
# молча откатывается на v6: в statistics остаются pipelineVersion="v6" и v7Fallback.
PIPELINE_V7_PERCENT=0
# Локальная отладка: 1 = гнать через v7 всё, игнорируя процент.
PIPELINE_V7_FORCE=
