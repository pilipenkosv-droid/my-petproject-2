# /etc/diplox-worker.env — 0600 root:root, значения вписывает владелец.
# Секреты берутся из ~/diplox/.env.local (те же, что в Vercel).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=
WORKER_ID=vds-1
NODE_ENV=production

# PANDOC_SERVICE_URL НЕ задавать: на сервере pandoc стоит локально, и пустое
# значение переключает сборку docx на локальный spawn("pandoc") вместо HTTP-хопа.
# PIPELINE_V7_PERCENT не задаём — в коде дефолт 100.
