# /etc/diplox-worker.env — 0600 root:root, значения вписывает владелец.
# Секреты берутся из ~/diplox/.env.local (те же, что в Vercel).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=
WORKER_ID=vds-1
# Бюджет LLM-разметки блоков на этапе confirm-rules. Дефолт в коде — 25 с под
# 60-секундную функцию Vercel; на воркере верхняя граница — дедлайн этапа (10 мин).
MARKUP_BUDGET_MS=300000
# Таймаут одной попытки вызова модели. Дефолт 50 с рассчитан на функцию Vercel
# с запасной моделью в очереди; у воркера модель одна — обрывать её незачем.
AI_CALL_TIMEOUT_MS=240000
NODE_ENV=production

# PANDOC_SERVICE_URL НЕ задавать: на сервере pandoc стоит локально, и пустое
# значение переключает сборку docx на локальный spawn("pandoc") вместо HTTP-хопа.
# PIPELINE_V7_PERCENT не задаём — в коде дефолт 100.
